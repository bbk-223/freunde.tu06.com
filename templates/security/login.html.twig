{% extends 'base.html.twig' %}

{% block title %}Anmelden Tu06.com - صفحه ورود - سایت دوست یابی ایرانیان داخل آلمان{% endblock %}

{% block body %}
<div class="container fix-logo">
    <div class="row">
        <div class="login-form bg-light mt-4 p-4">
            <form method="post" class="row g-3">
                <h1 class="h3 mb-3 font-weight-normal">Anmeldung</h1>

                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <div class="col-12">
                    <label for="inputEmail">Email</label>
                    <input type="email" name="email" id="inputEmail" class="form-control" value="{{ last_username }}" required autofocus>
                </div>
                <div class="col-12">
                    <label for="inputPassword">Passwort</label>
                    <input type="password" name="password" id="inputPassword" class="form-control" required>
                </div>

                <input type="hidden" name="_csrf_token"
                    value="{{ csrf_token('authenticate') }}"
                >

                <div class="col-12 d-flex justify-content-between">
                    <div class="text-center py-4 text-muted">
                        Haben Sie kein Konto?
                        <a href="{{ path('app_register') }}" class="text-muted font-weight-bold">Registrieren</a>
                    </div>
                    <button class="btn btn-outline-primary" type="submit">Anmelden</button>

                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

