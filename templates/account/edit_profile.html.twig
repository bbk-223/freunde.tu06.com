{% extends "base.html.twig" %}
{% block title %}Profilinformationen bearbeiten - Tu06.com - ویرایش پروفایل٬ سایت دوست یابی فارسی زبانان مقیم آلمان{% endblock %}

{% block body %}
    
<main class="py-5 fix-logo">
    <div class="container">
      <div class="row">
        {% include "./partials/_sidenav.html.twig" %}

        <div class="col-lg-9">
            {% if errors is defined %}
                {% for error in errors %}
                    <div class="alert alert-warning text-center">{{ error.message }}</div>
                {% endfor %}
            {% endif %}

            <form action="{{ path('app_update_profile') }}" method="POST" enctype="multipart/form-data">
              <div class="card">
                <div class="card-header card-title">
                  <strong>Profil bearbeiten</strong>
                </div>
                <div class="card-body">
                  <div class="row">
                    <div class="col-md-8">
                        {# @if (session('status') === 'profile-information-updated')
                            <div class="alert alert-success">Profil wurde aktualisiert.</div>
                        @endif #}
                      <div class="form-group">
                        <label for="name">Name</label>
                        <input type="text" name="name" value="{{ app.user.name }}" id="name" class="form-control">
                      </div>
                      <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" name="email" value="{{ app.user.email }}" id="email" class="form-control">
                      </div>

                      <div class="form-group mt-1">
                        <label for="gender">Geschlecht</label>
                        <select class="form-select" id="gender" name="gender" aria-label="Default select example">
                            <option {{ app.user.gender == 'männlich' ? 'selected' : '' }} value="männlich">männlich</option>
                            <option {{ app.user.gender == 'weiblich' ? 'selected' : '' }} value="weiblich">weiblich</option>
                        </select>
                      </div>

                      <div class="form-group mt-1">
                        <label for="birth">Geburtsdatum</label>
                        <input type="datetime" name="birth" value="{{ app.user.birth|date('d-m-Y') }}" id="birth" class="form-control">
                      </div>

                      <div class="form-group mt-1">
                        <label for="relationship">Beziehung</label>
                        <select class="form-select" id="relationship" name="relationship" aria-label="Default select example">
                            <option {{ app.user.relationship == 'single' ? 'selected' : '' }} value="single">Single</option>
                            <option {{ app.user.relationship == 'verheiratet' ? 'selected' : '' }} value="verheiratet">Verheiratet</option>
                            <option {{ app.user.relationship == 'geschieden' ? 'selected' : '' }} value="geschieden">Geschieden</option>
                        </select>
                      </div>

                      <div class="form-group">
                        <label for="country">Land</label>
                        <input type="text" name="country" id="country" value="Deutschland" readonly class="form-control">
                      </div>

                      <div class="form-group">
                        <label for="state">Bundesland</label>
                        <input type="text" name="state" value="{{ app.user.state }}" id="state" class="form-control">
                      </div>

                      <div class="form-group">
                        <label for="city">Stadt</label>
                        <input type="text" name="city" value="{{ app.user.city }}" id="city" class="form-control">
                      </div>

                      <div class="form-group mt-1">
                        <label for="">Ich suche nach (Alter)</label>
                        <div class="row want-age">
                        von
                        <div class="col-4">
                        <select class="form-select" id="start_want_age" name="start_want_age" aria-label="Default select example">
                            {% for i in 18..90 %}
                            <option {{ app.user.startwantage == i ? 'selected' : '' }} value="{{i}}">{{i}}</option>
                            {% endfor %}
                        </select>
                        </div>
                        bis
                        <div class="col-4">
                        <select class="form-select" id="end_want_age" name="end_want_age" aria-label="Default select example">
                            {% for i in 18..90 %}
                            <option {{ app.user.endwantage == i ? 'selected' : '' }} value="{{i}}">{{i}}</option>
                            {% endfor %}
                        </select>
                        </div>
                      </div>
                      </div>

                      <div class="form-group">
                        <label for="favorites">Hobbys</label>
                        <textarea name="favorites" id="favorites" rows="3" class="form-control">{{ app.user.favorites }}</textarea>                      </div>
                    </div>

					<div class="col-lg-3">
						<div class="bg-secondary-soft px-4 py-5 rounded">
							<div class="row g-3">
                <img src="{{ app.user.profilePictureUrl() }}" alt="..." style="width: 150px; height: 150px;" />
								<div class="text-center">
									<!-- Image upload -->
									<div class="square position-relative display-2 mb-3">
										<i class="fas fa-fw fa-user position-absolute top-50 start-50 translate-middle text-secondary"></i>
									</div>
									<!-- Button -->
									<input type="file" id="customFile" name="profile_picture" hidden="">
									<label class="btn btn-success-soft btn-block" for="customFile">Upload</label>
									<button type="button" class="btn btn-danger-soft mt-2">Remove</button>
									<!-- Content -->
									<p class="text-muted mt-3 mb-0"><span class="me-1">Note:</span>Minimum size 300px x 300px</p>
								</div>
							</div>
						</div>
					</div>
				</div>
                  <div class="card-footer">
                    <div class="row">
                      <div class="col-md-8">
                        <div class="row">
                          <div class="col-md-offset-3 col-md-6">
                            <button type="submit" class="btn btn-success">Profil aktualisieren</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
            </form>
          </div>
        </div>
      </div>
</main>

{% endblock %}

{% block stylesheets %}
{{ encore_entry_link_tags('app_profile') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('app_profile') }}
{% endblock %}